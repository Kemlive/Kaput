{
  "name": "kaput",
  "version": "1.0.0",
  "description": "Privacy wallet with auto-sweep to Arbitrum",
  "scripts": {
    "compile": "hardhat compile",
    "deploy": "hardhat run scripts/deploy.js",
    "postinstall": "node -e \"const fs=require('fs');const p='node_modules/util/util.js';if(!fs.existsSync(p))process.exit(0);let c=fs.readFileSync(p,'utf8');if(!c.includes('exports.TextEncoder')){c+='\\nexports.TextEncoder=globalThis.TextEncoder;exports.TextDecoder=globalThis.TextDecoder;\\n';fs.writeFileSync(p,c);}\""
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-ethers": "^3.1.3",
    "@nomicfoundation/hardhat-verify": "^3.1.0",
    "@openzeppelin/contracts": "^5.6.1",
    "@railgun-community/engine": "^9.6.0",
    "@railgun-community/shared-models": "^8.0.2",
    "@railgun-community/wallet": "^10.9.0",
    "dotenv": "^17.4.2",
    "ethers": "6.14.3",
    "hardhat": "^2.22.19"
  },
  "dependencies": {
    "@fluidkey/stealth-account-kit": "^1.1.1",
    "@railgun-community/waku-broadcaster-client-web": "^9.1.1",
    "level-js": "^6.1.0",
    "path-browserify": "^1.0.1",
    "snarkjs": "^0.7.6",
    "socks-proxy-agent": "^10.1.0",
    "viem": "^2.56.5"
  }
}
